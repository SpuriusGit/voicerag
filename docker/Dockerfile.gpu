# GPU image: adds torch/CUDA, sentence-transformers, faster-whisper and PEFT.
# Run with:  docker run --gpus all ...
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/models

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 app
WORKDIR /app

COPY requirements.txt requirements-ml.txt ./
RUN python3.11 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r requirements.txt \
    && /opt/venv/bin/pip install -r requirements-ml.txt

COPY pyproject.toml README.md ./
COPY src ./src
COPY prompts ./prompts
COPY data ./data
COPY finetune ./finetune
RUN /opt/venv/bin/pip install --no-deps .

ENV PATH="/opt/venv/bin:$PATH" \
    VOICERAG_RAG__DEVICE=cuda \
    VOICERAG_STT__DEVICE=cuda \
    VOICERAG_RAG__STORE_PATH=/app/storage/index

# Model weights live on a mounted volume; baking them into the image would add
# several GB and force a rebuild on every model change.
RUN mkdir -p /app/storage /app/models && chown -R app:app /app
USER app

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["sh", "-c", "[ -f \"$VOICERAG_RAG__STORE_PATH/meta.json\" ] || voicerag ingest --corpus /app/data/corpus; exec voicerag serve"]
