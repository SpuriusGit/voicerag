# ---------- LLM backend ----------
# one of: ollama | openai_compat | echo
VOICERAG_LLM__BACKEND=ollama
VOICERAG_LLM__MODEL=qwen2.5:3b-instruct
VOICERAG_LLM__BASE_URL=http://localhost:11434
VOICERAG_LLM__API_KEY=
VOICERAG_LLM__TEMPERATURE=0.1
VOICERAG_LLM__MAX_TOKENS=512
VOICERAG_LLM__TIMEOUT_S=120

# ---------- Embeddings / retrieval ----------
# one of: sentence_transformers | hashing (deterministic, dependency-free fallback)
VOICERAG_RAG__EMBEDDER=sentence_transformers
VOICERAG_RAG__EMBEDDING_MODEL=intfloat/multilingual-e5-small
VOICERAG_RAG__RERANKER=cross_encoder          # cross_encoder | noop
VOICERAG_RAG__RERANKER_MODEL=BAAI/bge-reranker-v2-m3
VOICERAG_RAG__TOP_K=20
VOICERAG_RAG__TOP_N=4
# How BM25 joins dense retrieval: lexical_gate | always | off.
# 'lexical_gate' skips fusion when the query shares too little vocabulary with
# the index - a query in a language the corpus lacks makes BM25 return noise,
# and RRF weighs that noise equally by rank. See docs/EXPERIMENTS.md E1c.
VOICERAG_RAG__FUSION=lexical_gate
VOICERAG_RAG__MIN_LEXICAL_OVERLAP=0.35
VOICERAG_RAG__CHUNK_SIZE=800
VOICERAG_RAG__CHUNK_OVERLAP=120
VOICERAG_RAG__STORE_PATH=storage/index
VOICERAG_RAG__DEVICE=auto                     # auto | cpu | cuda

# ---------- STT ----------
VOICERAG_STT__BACKEND=faster_whisper          # faster_whisper | stub
VOICERAG_STT__MODEL=small
VOICERAG_STT__DEVICE=auto
VOICERAG_STT__COMPUTE_TYPE=int8_float16
VOICERAG_STT__LANGUAGE=                       # empty -> auto-detect
VOICERAG_STT__BEAM_SIZE=5

# ---------- Prompts ----------
VOICERAG_PROMPTS__DIR=prompts
# Pin the served prompt explicitly; @latest would promote any new file on sight.
VOICERAG_PROMPTS__ANSWER=rag_answer@v3
VOICERAG_PROMPTS__JUDGE=judge_faithfulness@latest

# ---------- Service ----------
VOICERAG_SERVICE__HOST=0.0.0.0
VOICERAG_SERVICE__PORT=8000
VOICERAG_SERVICE__LOG_LEVEL=INFO
VOICERAG_SERVICE__MAX_UPLOAD_MB=25
